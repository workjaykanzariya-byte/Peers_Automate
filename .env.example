# DOOT — Environment Configuration

# Node Environment
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# PostgreSQL Database (DOOT on local port 5432)
DATABASE_URL="postgresql://postgres:2004@localhost:5432/DOOT?schema=public"

# Redis (BullMQ and Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_SECRET=super-secret-doot-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

# Cryptographic Master Key for Third-Party API Credentials (AES-256-GCM: 32 bytes hex encoded = 64 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY_V1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Meta WhatsApp Cloud API Global Defaults (Platform level app config)
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_WEBHOOK_VERIFY_TOKEN=doot_webhook_verify_token_default

# Frontend URL (for CORS and cookie origin)
FRONTEND_URL=http://localhost:5173
