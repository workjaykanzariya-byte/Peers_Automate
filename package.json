{
  "name": "doot-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "DOOT — Enterprise Multi-Tenant WhatsApp SaaS Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "dev:api": "npm run start:dev --workspace=@doot/api",
    "dev:web": "npm run dev --workspace=@doot/web",
    "prisma:generate": "npm run prisma:generate --workspace=@doot/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=@doot/api",
    "prisma:studio": "npm run prisma:studio --workspace=@doot/api"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
