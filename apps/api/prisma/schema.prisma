// DOOT — Multi-Tenant PostgreSQL Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  AGENT
  ANALYST
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum MetaIntegrationStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR
}

enum QualityRating {
  GREEN
  YELLOW
  RED
  UNKNOWN
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  APPROVED
  PENDING
  REJECTED
  PAUSED
  DISABLED
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  TEMPLATE
  INTERACTIVE
  LOCATION
}

enum MessageStatus {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  QUEUED
  PROCESSING
  COMPLETED
  PARTIALLY_FAILED
  FAILED
  CANCELLED
}

enum ImportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ----------------------------------------------------
// 1. Users & Global Identity
// ----------------------------------------------------
model User {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique @db.VarChar(255)
  passwordHash    String        @map("password_hash") @db.VarChar(255)
  firstName       String?       @map("first_name") @db.VarChar(100)
  lastName        String?       @map("last_name") @db.VarChar(100)
  phone           String?       @db.VarChar(50)
  avatarUrl       String?       @map("avatar_url") @db.Text
  isActive        Boolean       @default(true) @map("is_active")
  isPlatformAdmin Boolean       @default(false) @map("is_platform_admin")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  memberships     Membership[]
  refreshSessions RefreshSession[]
  assignedContacts Contact[]    @relation("AssignedContactUser")
  assignedConversations Conversation[] @relation("AssignedConversationUser")
  createdTickets  SupportTicket[] @relation("TicketCreator")
  assignedTickets SupportTicket[] @relation("TicketAssignee")
  ticketComments  TicketComment[]
  auditLogs       AuditLog[]

  @@map("users")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  userAgent  String?   @map("user_agent") @db.Text
  ipAddress  String?   @map("ip_address") @db.VarChar(45)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_sessions")
}

// ----------------------------------------------------
// 2. Multi-Tenant Organizations & Memberships
// ----------------------------------------------------
model Organization {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @db.VarChar(255)
  slug        String             @unique @db.VarChar(100)
  planTier    String             @default("STARTER") @map("plan_tier") @db.VarChar(50)
  status      OrganizationStatus @default(ACTIVE)
  timezone    String             @default("UTC") @db.VarChar(50)
  settings    Json               @default("{}")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  memberships         Membership[]
  metaIntegrations    MetaIntegration[]
  phoneNumbers        PhoneNumber[]
  contacts            Contact[]
  tags                Tag[]
  contactGroups       ContactGroup[]
  whatsappTemplates   WhatsAppTemplate[]
  conversations       Conversation[]
  messages            Message[]
  campaigns           Campaign[]
  webhookEndpoints    WebhookEndpoint[]
  webhookDeliveryLogs WebhookDeliveryLog[]
  automationFlows     AutomationFlow[]
  contactImports      ContactImport[]
  auditLogs           AuditLog[]
  subscription        Subscription?
  invoices            Invoice[]
  supportTickets      SupportTicket[]
  notifications       Notification[]
  aiAssistantConfig   AiAssistantConfig?
  messengerIntegrations MessengerIntegration[]

  @@map("organizations")
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           UserRole     @default(AGENT)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}

// ----------------------------------------------------
// 3. Meta WhatsApp Assets & Credentials
// ----------------------------------------------------
model MetaIntegration {
  id                   String                @id @default(uuid()) @db.Uuid
  organizationId       String                @map("organization_id") @db.Uuid
  metaBusinessId       String                @map("meta_business_id") @db.VarChar(100)
  wabaId               String                @map("waba_id") @db.VarChar(100)
  name                 String                @db.VarChar(255)
  encryptedAccessToken String                @map("encrypted_access_token") @db.Text
  tokenKeyVersion      String                @default("v1") @map("token_key_version") @db.VarChar(10)
  tokenExpiresAt       DateTime?             @map("token_expires_at") @db.Timestamptz
  webhookVerifyToken   String                @map("webhook_verify_token") @db.VarChar(255)
  status               MetaIntegrationStatus @default(CONNECTED)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phoneNumbers         PhoneNumber[]
  whatsappTemplates    WhatsAppTemplate[]

  @@index([organizationId])
  @@map("meta_integrations")
}

model PhoneNumber {
  id                 String        @id @default(uuid()) @db.Uuid
  organizationId     String        @map("organization_id") @db.Uuid
  metaIntegrationId  String        @map("meta_integration_id") @db.Uuid
  phoneNumberId      String        @unique @map("phone_number_id") @db.VarChar(100)
  displayPhoneNumber String        @map("display_phone_number") @db.VarChar(50)
  verifiedName       String?       @map("verified_name") @db.VarChar(255)
  qualityRating      QualityRating @default(UNKNOWN) @map("quality_rating")
  messagingLimitTier String        @default("TIER_250") @map("messaging_limit_tier") @db.VarChar(50)
  status             String        @default("CONNECTED") @db.VarChar(50)
  isDefault          Boolean       @default(false) @map("is_default")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metaIntegration    MetaIntegration @relation(fields: [metaIntegrationId], references: [id], onDelete: Cascade)
  conversations      Conversation[]
  campaigns          Campaign[]

  @@index([organizationId, isDefault])
  @@map("phone_numbers")
}

// ----------------------------------------------------
// 4. Contacts, Leads & Taxonomy
// ----------------------------------------------------
model Contact {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  phone            String       @db.VarChar(50)
  firstName        String?      @map("first_name") @db.VarChar(100)
  lastName         String?      @map("last_name") @db.VarChar(100)
  email            String?      @db.VarChar(255)
  companyName      String?      @map("company_name") @db.VarChar(150)
  notes            String?      @db.Text
  priority         String       @default("MEDIUM") @db.VarChar(20)
  followUpDate     DateTime?    @map("follow_up_date") @db.Timestamptz
  optedOutAt       DateTime?    @map("opted_out_at") @db.Timestamptz
  leadStatus       LeadStatus   @default(NEW) @map("lead_status")
  leadSource       String?      @map("lead_source") @db.VarChar(100)
  assignedToUserId String?      @map("assigned_to_user_id") @db.Uuid
  customFields     Json         @default("{}") @map("custom_fields")
  isBlocked        Boolean      @default(false) @map("is_blocked")
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedToUser   User?        @relation("AssignedContactUser", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  tags             ContactTag[]
  groupMemberships ContactGroupMember[]
  conversations    Conversation[]
  campaignRecipients CampaignRecipient[]

  @@unique([organizationId, phone])
  @@index([organizationId, leadStatus])
  @@map("contacts")
}

model Tag {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(100)
  color          String       @default("#4F46E5") @db.VarChar(20)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       ContactTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

model ContactTag {
  contactId String  @map("contact_id") @db.Uuid
  tagId     String  @map("tag_id") @db.Uuid

  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

model ContactGroup {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  name           String               @db.VarChar(150)
  description    String?              @db.Text
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        ContactGroupMember[]

  @@unique([organizationId, name])
  @@map("contact_groups")
}

model ContactGroupMember {
  groupId   String       @map("group_id") @db.Uuid
  contactId String       @map("contact_id") @db.Uuid

  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  contact   Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([groupId, contactId])
  @@map("contact_group_members")
}

// ----------------------------------------------------
// 5. WhatsApp Templates
// ----------------------------------------------------
model WhatsAppTemplate {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  metaIntegrationId String           @map("meta_integration_id") @db.Uuid
  metaTemplateId    String           @map("meta_template_id") @db.VarChar(100)
  name              String           @db.VarChar(255)
  language          String           @db.VarChar(20)
  category          TemplateCategory
  status            TemplateStatus
  components        Json
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  metaIntegration   MetaIntegration  @relation(fields: [metaIntegrationId], references: [id], onDelete: Cascade)
  campaigns         Campaign[]

  @@unique([organizationId, name, language])
  @@index([organizationId, status])
  @@map("whatsapp_templates")
}

// ----------------------------------------------------
// 6. Inbox, Conversations & Messages
// ----------------------------------------------------
model Conversation {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String             @map("organization_id") @db.Uuid
  contactId       String             @map("contact_id") @db.Uuid
  phoneNumberId   String             @map("phone_number_id") @db.Uuid
  assignedUserId  String?            @map("assigned_user_id") @db.Uuid
  status          ConversationStatus @default(OPEN)
  lastMessageAt   DateTime           @default(now()) @map("last_message_at") @db.Timestamptz
  windowExpiresAt DateTime?          @map("window_expires_at") @db.Timestamptz
  unreadCount     Int                @default(0) @map("unread_count")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact         Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  phoneNumber     PhoneNumber        @relation(fields: [phoneNumberId], references: [id], onDelete: Restrict)
  assignedUser    User?              @relation("AssignedConversationUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages        Message[]

  @@index([organizationId, status, lastMessageAt])
  @@index([contactId])
  @@map("conversations")
}

model Message {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  metaMessageId  String?          @unique @map("meta_message_id") @db.VarChar(255)
  direction      MessageDirection
  type           MessageType      @default(TEXT)
  body           String?          @db.Text
  mediaUrl       String?          @map("media_url") @db.Text
  mediaType      String?          @map("media_type") @db.VarChar(100)
  status         MessageStatus    @default(SENT)
  errorCode      String?          @map("error_code") @db.VarChar(50)
  errorMessage   String?          @map("error_message") @db.Text
  sentAt         DateTime?        @map("sent_at") @db.Timestamptz
  deliveredAt    DateTime?        @map("delivered_at") @db.Timestamptz
  readAt         DateTime?        @map("read_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([conversationId, createdAt])
  @@map("messages")
}

// ----------------------------------------------------
// 7. Campaigns & Bulk Dispatch
// ----------------------------------------------------
model Campaign {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  phoneNumberId   String              @map("phone_number_id") @db.Uuid
  templateId      String              @map("template_id") @db.Uuid
  name            String              @db.VarChar(255)
  description     String?             @db.Text
  isBulkCsv       Boolean             @default(false) @map("is_bulk_csv")
  csvFilename     String?             @map("csv_filename") @db.VarChar(255)
  rateLimitPerSec Int                 @default(20) @map("rate_limit_per_sec")
  status          CampaignStatus      @default(DRAFT)
  totalRecipients Int                 @default(0) @map("total_recipients")
  sentCount       Int                 @default(0) @map("sent_count")
  deliveredCount  Int                 @default(0) @map("delivered_count")
  readCount       Int                 @default(0) @map("read_count")
  failedCount     Int                 @default(0) @map("failed_count")
  scheduledAt     DateTime?           @map("scheduled_at") @db.Timestamptz
  startedAt       DateTime?           @map("started_at") @db.Timestamptz
  completedAt     DateTime?           @map("completed_at") @db.Timestamptz
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  phoneNumber     PhoneNumber         @relation(fields: [phoneNumberId], references: [id], onDelete: Restrict)
  template        WhatsAppTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  recipients      CampaignRecipient[]

  @@index([organizationId, status])
  @@map("campaigns")
}

model CampaignRecipient {
  id                 String        @id @default(uuid()) @db.Uuid
  campaignId         String        @map("campaign_id") @db.Uuid
  contactId          String?       @map("contact_id") @db.Uuid
  phone              String        @db.VarChar(50)
  templateParameters Json          @default("[]") @map("template_parameters")
  status             MessageStatus @default(SENDING)
  metaMessageId      String?       @map("meta_message_id") @db.VarChar(255)
  errorMessage       String?       @map("error_message") @db.Text
  sentAt             DateTime?     @map("sent_at") @db.Timestamptz
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz

  campaign           Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact            Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@map("campaign_recipients")
}

// ----------------------------------------------------
// 8. Webhooks & Logs
// ----------------------------------------------------
model WebhookEndpoint {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  name           String               @default("Webhook Endpoint") @db.VarChar(150)
  url            String               @db.Text
  secret         String               @db.VarChar(255)
  description    String?              @db.VarChar(255)
  events         String[]
  payloadMapping Json?                @map("payload_mapping")
  isActive       Boolean              @default(true) @map("is_active")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveryLogs   WebhookDeliveryLog[]

  @@index([organizationId, isActive])
  @@map("webhook_endpoints")
}

model WebhookDeliveryLog {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  webhookEndpointId String          @map("webhook_endpoint_id") @db.Uuid
  eventId           String?         @map("event_id") @db.VarChar(100)
  event             String          @db.VarChar(100)
  requestPayload    Json            @map("request_payload")
  responseStatus    Int?            @map("response_status")
  responseBody      String?         @map("response_body") @db.Text
  durationMs        Int             @map("duration_ms")
  attempts          Int             @default(1)
  errorMessage      String?         @map("error_message") @db.Text
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz

  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  webhookEndpoint   WebhookEndpoint @relation(fields: [webhookEndpointId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([webhookEndpointId, createdAt])
  @@map("webhook_delivery_logs")
}

// ----------------------------------------------------
// 9. Automation Flows & Bot Engine
// ----------------------------------------------------
model AutomationFlow {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(255)
  triggerType    String       @map("trigger_type") @db.VarChar(100)
  triggerConfig  Json         @default("{}") @map("trigger_config")
  steps          Json         @default("[]")
  isActive       Boolean      @default(false) @map("is_active")
  executionCount Int          @default(0) @map("execution_count")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@map("automation_flows")
}

// ----------------------------------------------------
// 10. Contact Imports Pipeline
// ----------------------------------------------------
model ContactImport {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  filename       String       @db.VarChar(255)
  totalRows      Int          @default(0) @map("total_rows")
  importedRows   Int          @default(0) @map("imported_rows")
  failedRows     Int          @default(0) @map("failed_rows")
  status         ImportStatus @default(PENDING)
  errorReport    Json         @default("[]") @map("error_report")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("contact_imports")
}

// ----------------------------------------------------
// 11. Security Audit Logs
// ----------------------------------------------------
model AuditLog {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  action         String        @db.VarChar(100)
  resource       String        @db.VarChar(100)
  resourceId     String?       @map("resource_id") @db.VarChar(100)
  metadata       Json          @default("{}")
  ipAddress      String?       @map("ip_address") @db.VarChar(45)
  userAgent      String?       @map("user_agent") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

// ----------------------------------------------------
// 12. SaaS Subscription Plans & Billing
// ----------------------------------------------------
model Plan {
  id                  String         @id @default(uuid()) @db.Uuid
  name                String         @db.VarChar(100)
  tier                String         @unique @db.VarChar(50)
  monthlyPrice        Decimal        @default(0) @map("monthly_price") @db.Decimal(10, 2)
  annualPrice         Decimal        @default(0) @map("annual_price") @db.Decimal(10, 2)
  currency            String         @default("USD") @db.VarChar(10)
  maxContacts         Int            @default(1000) @map("max_contacts")
  maxMonthlyMessages  Int            @default(2500) @map("max_monthly_messages")
  maxPhoneNumbers     Int            @default(1) @map("max_phone_numbers")
  maxTeamMembers      Int            @default(2) @map("max_team_members")
  features            Json           @default("[]")
  isActive            Boolean        @default(true) @map("is_active")
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  subscriptions       Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String       @id @default(uuid()) @db.Uuid
  organizationId         String       @unique @map("organization_id") @db.Uuid
  planId                 String       @map("plan_id") @db.Uuid
  status                 String       @default("TRIAL") @db.VarChar(50)
  currentPeriodStart     DateTime     @default(now()) @map("current_period_start") @db.Timestamptz
  currentPeriodEnd       DateTime     @map("current_period_end") @db.Timestamptz
  cancelAtPeriodEnd      Boolean      @default(false) @map("cancel_at_period_end")
  provider               String       @default("MANUAL") @db.VarChar(50)
  providerSubscriptionId String?      @map("provider_subscription_id") @db.VarChar(255)
  providerCustomerId     String?      @map("provider_customer_id") @db.VarChar(255)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                   Plan         @relation(fields: [planId], references: [id], onDelete: Restrict)
  invoices               Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  invoiceNumber  String        @unique @map("invoice_number") @db.VarChar(100)
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("USD") @db.VarChar(10)
  status         String        @default("PAID") @db.VarChar(50)
  billingDate    DateTime      @default(now()) @map("billing_date") @db.Timestamptz
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz
  pdfUrl         String?       @map("pdf_url") @db.Text
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([organizationId, billingDate])
  @@map("invoices")
}

// ----------------------------------------------------
// 13. Support Tickets & Collaboration
// ----------------------------------------------------
model SupportTicket {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  ticketNumber    String          @unique @map("ticket_number") @db.VarChar(50)
  subject         String          @db.VarChar(255)
  description     String          @db.Text
  category        String          @default("GENERAL") @db.VarChar(50)
  priority        String          @default("MEDIUM") @db.VarChar(50)
  status          String          @default("NEW") @db.VarChar(50)
  assignedStaffId String?         @map("assigned_staff_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator         User            @relation("TicketCreator", fields: [userId], references: [id], onDelete: Cascade)
  assignedStaff   User?           @relation("TicketAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  comments        TicketComment[]

  @@index([organizationId, status])
  @@index([status, priority])
  @@map("support_tickets")
}

model TicketComment {
  id             String        @id @default(uuid()) @db.Uuid
  ticketId       String        @map("ticket_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  isInternalNote Boolean       @default(false) @map("is_internal_note")
  content        String        @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

// ----------------------------------------------------
// 14. Notifications Center
// ----------------------------------------------------
model Notification {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid
  type           String       @db.VarChar(100)
  title          String       @db.VarChar(255)
  message        String       @db.Text
  data           Json         @default("{}")
  isRead         Boolean      @default(false) @map("is_read")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, isRead])
  @@map("notifications")
}

// ----------------------------------------------------
// 15. AI Assistant & Knowledge Base
// ----------------------------------------------------
model AiAssistantConfig {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String       @unique @map("organization_id") @db.Uuid
  provider            String       @default("OPENAI") @db.VarChar(50)
  encryptedApiKey     String?      @map("encrypted_api_key") @db.Text
  model               String       @default("gpt-4o") @db.VarChar(100)
  systemInstructions  String?      @map("system_instructions") @db.Text
  isEnabled           Boolean      @default(false) @map("is_enabled")
  temperature         Decimal      @default(0.7) @db.Decimal(3, 2)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("ai_assistant_configs")
}

// ----------------------------------------------------
// 16. Facebook Messenger Integration
// ----------------------------------------------------
model MessengerIntegration {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  pageId             String       @map("page_id") @db.VarChar(100)
  pageName           String       @map("page_name") @db.VarChar(255)
  encryptedPageToken String       @map("encrypted_page_token") @db.Text
  status             String       @default("CONNECTED") @db.VarChar(50)
  subscribedFields   Json         @default("[\"messages\",\"messaging_postbacks\"]") @map("subscribed_fields")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, pageId])
  @@map("messenger_integrations")
}

// ----------------------------------------------------
// 17. System & Platform Global Settings
// ----------------------------------------------------
model SystemSetting {
  key         String   @id @db.VarChar(100)
  value       Json
  description String?  @db.VarChar(255)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("system_settings")
}


